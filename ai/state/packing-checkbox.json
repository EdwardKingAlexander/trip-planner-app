    "endpoint_contract": {
        "method": "PATCH",
        "url": "/trips/{trip}/packing-items/{packingItem}/packed",
        "name": "trips.packing-items.toggle-packed",
        "request_body": { "is_packed": "boolean (required)" },
        "success_response": "302 back() with success flash",
        "error_responses": {
            "validation": "422",
            "not_authorized": "403",
            "wrong_trip": "404",
            "unauthenticated": "302 to login"
        },
        "authorization": "trip update policy",
        "activity_event": {
            "event_type": "packing.toggled",
            "changed_area": "packing",
            "summary_packed": "marked packed: {label}",
            "summary_unpacked": "marked unpacked: {label}"
        }
    },
    "ux_rules": {
        "checkbox_position": "row leading edge, replaces the 'Packed' pill",
        "optimistic": true,
        "rollback_on_failure": "instant flip back, inline error visible 4s",
        "visually_de_emphasize_when_packed": "text-muted-foreground line-through on label only",
        "disabled_when_not_editable": true,
        "edit_form_in_form_checkbox": "kept for now",
        "progress_header": "{packed} of {total} packed + thin progress bar using --primary",
        "hide_packed_filter": {
            "default": false,
            "persistence": "localStorage per-trip",
            "key_template": "packing-hide-packed:{tripId}"
        },
        "sort_packed_to_bottom": true,
        "all_packed_with_filter_on": "celebratory empty state with CheckCircle2 icon"
    },
